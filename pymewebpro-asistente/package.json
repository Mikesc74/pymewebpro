{
  "name": "pymewebpro-asistente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create asistente-db",
    "db:migrate": "wrangler d1 execute asistente-db --remote --file=migrations/001_init.sql",
    "db:migrate:local": "wrangler d1 execute asistente-db --local --file=migrations/001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
